<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <div class="main-layout">
      <% if (locals.currentUser) { %>
        <!-- Sidebar  -->
        <%- include('../partials/sidebar.ejs') %>

        <!-- Main content-->
        <main class="main">
          <!-- File Details -->
          <div class="file-info">
            <!-- Breadcrumbs navigation -->
            <% if(locals.breadcrumbs) { %>
              <nav class="breadcrumbs" aria-label="Breadcrumbs">
                <ol class="breadcrumbs__list" role="list">
                  <li class="breadcrumbs__item">
                    <a class="link--home" href="/">Home</a>
                  </li>
                  <% breadcrumbs.forEach(breadcrumb => { %>
                    <li class="breadcrumbs__item">
                       <span class="breadcrumbs__separator" aria-hidden="true">&nbsp;»&nbsp;</span> 
                       <a class="breadcrumbs__link" href="/folders/<%= breadcrumb.id %>"><%= breadcrumb.name %></a>
                    </li>
                  <% }) %>
                </ol>
              </nav>
            <% } %>

            <!-- Show file details -->
            <% if (locals.file ) { %>
              <div class="file-info__container">
                <div class="file-info__wrapper">
                  <!-- File preview -->
                  <div class="file-info__preview">
                    <% if (locals.previewType) { %>
                      <% if (previewType === 'image') { %>
                        <img class="file-info__img" src="<%= locals.previewUrl %>" alt="" width="400" height="250">
                      <% } else if(previewType === 'audio'){ %>
                        <audio class="file-info__audio" controls  src="<%= locals.previewUrl %>"></audio>
                      <% } else if (previewType === 'video') { %>
                        <video src="<%= locals.previewUrl %>"></video>
                      <% } else { %>
                        <img src="<%= locals.previewUrl %>" alt="" width="400" height="250">
                      <% } %>
                    <% } %>
                  </div>
                  <!-- File info -->
                  <ul class="file-info__list">
                    <li class="file-info__item file-info__name " data-name="<%= file.name %>"><span><strong>Name:</strong> </span><span id="file-name"><%= file.name %></span></li>
                    <li class="file-info__item file-info__size" data-size="<%= file.size %>"><span><strong>Size:</strong> </span><span id="file-size"><%= file.size %></span></li>
                    <li class="file-info__item file-info__type" data-type="<%= file.type %>"><span><strong>Type:</strong> </span><span id="file-type"><%= file.type %></span></li>
                    <li class="file-info__item file-info__date" data-date="<%= file.uploadedAt.toISOString() %>"><span><strong>Time uploaded:</strong> </span><span id="file-date"><%= file.uploadedAt.toUTCString() %></span></li>
                  </ul>
                </div>
              </div>
            <% } %>
          </div>
        </main>
      <% } %>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>
  </body>

   <script>

    const fileType = document.querySelector('#file-type')
    

    const fileNameDisplay = document.querySelector('.file-info__name')
    const originalFileName = fileNameDisplay.getAttribute('data-name')
    const fileName = document.querySelector('#file-name')

    const fileSizeDisplay = document.querySelector('.file-info__size')
    const originalFileSize = fileSizeDisplay.getAttribute('data-size')
    const fileSize = document.querySelector('#file-size')

    const fileDateDisplay = document.querySelector('.file-info__date')
    const originalFileDate = fileDateDisplay.getAttribute('data-date')
    // console.log(originalFileDate)
    const fileDate = document.querySelector('#file-date')

    /* Remove file extension from name and get file type */
    function removeFileExtensionAndDisplayFileType(fullName) {
      const fileNameArr = fullName.split('.')

      // Remove file extension
      const baseName = fileNameArr[0]
      fileName.textContent = `${baseName}`

      // Show file type
      const extension = fileNameArr[1]
      fileType.textContent = `${extension}`
    }
    
    /* Display file size */
    function displayFileSize(bytes) {
      bytes = Number(bytes)
      let number = ''

      if (bytes < 1024) {
        number = `${bytes} bytes`;
      } else if (bytes >= 1024 && bytes < 1024 * 1024) {
        number = `${(bytes / 1024).toFixed(2)} KB`;
      } else {
        number = `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
      }
      
      fileSize.textContent = `${number}`
    }

    /* Display file date uploaded */
    function displayDate(date) {
      // Convert the date into local date and time
      const localDate = new Date(date).toLocaleString()
      fileDate.textContent = `${localDate}`
    }

    removeFileExtensionAndDisplayFileType(originalFileName)
    displayFileSize(originalFileSize)
    displayDate(originalFileDate)
  </script>  
</html>