<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <div class="main-layout">
        <% if (locals.currentUser) { %>
          <!-- Sidebar  -->
        <%- include('../partials/sidebar.ejs') %>
        <% } %>

    <!-- Main content-->
    <main class="main">
      <!-- Show errors -->
      <% if(locals.errors) { %>
        <%- include('../partials/errors.ejs') %>
      <% }  %>

      <div class="upload">
        <form class="form upload__form" action="<%= locals.folderId ? `/folders/${folderId}/files/upload` : `/files/upload` %>" method="post" enctype="multipart/form-data" novalidate>
          <div class="form__control">
            <label class="upload__label btn" for="fileUpload">Select files to upload </label>
            <ul class="upload__list">
              <li><strong>Supported formats: </strong>Images, audio, video, PDF, DOC, and DOCX.</li>
              <li><strong>Limits: </strong>Up to 5 files at a time, max 20 MB per file.</li>
            </ul>
            
            <!-- Many mobile devices also let the user take a picture with the camera when 'image/*' is used -->
          
            <input class="form__input" type="file" id="fileUpload" name="fileUpload" accept=".doc, .docx, .pdf, image/*, audio/*, video/*" multiple />
          </div>
          <div class="upload__preview">
            <p class="upload__text">No files currently selected for upload</p>
          </div>
          <div class="errors">
            <ul class="errors__list"></ul>
          </div>
          
          <div class="form__btns">
            <button class=" btn btn--cancel" type="button">Clear</button>
            <button class=" btn btn--submit">Submit</button>
          </div>
        </form>
        
      </div>
    </main>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>

    
  </body>

  <script>
    const fileInput = document.querySelector("#fileUpload");
    const errorsList = document.querySelector('.errors__list')
    const preview = document.querySelector(".upload__preview");
    const submitBtn = document.querySelector(".btn--submit")
    const clearBtn = document.querySelector('.btn--clear')


    fileInput.style.opacity = 0;
    submitBtn.disabled = true
    clearBtn.disabled = true

    
    let currentFilesArr

    const allowedFileTypes = [
      "image/*",
      "audio/*",
      "video/*",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/pdf",
    ];

    function validateFileTypeAndSize() {
      currentFilesArr = [];
      const currentFiles = fileInput.files;
      const maxFileSize = 20 * 1024 * 1024; // 20 MB

      for (const file of currentFiles) {
        const fileType = file.type;
        const fileSize = file.size;

        // Check file size
        if (fileSize > maxFileSize) {
          displayError(file, 'bigFile')
          continue; // Skip to the next file
        }

        // .some() returns true as soon as it finds a match and stops looping
        const isAllowed = allowedFileTypes.some(type => {
          if (type.endsWith('/*')) {
            const prefix = type.split('/')[0];
            return fileType.startsWith(prefix + '/');
          }
          return fileType === type;
        });

        if (isAllowed) {
          currentFilesArr.push(file);
        } else {
          displayError(file, 'wrongType')
        }
      }
    }

    //  Remove files if there are more than 5
    function validateFileListLength() {
      if(currentFilesArr.length > 5) {
        currentFilesArr.splice(5)
        displayError(null, 'tooMany')
      }

      submitBtn.disabled = currentFilesArr.length === 0
    }

    // Display error messages for invalid files
    function displayError(file, errorType) {
      const listItem = document.createElement('li')

      const errorMsgs = {
        'bigFile': `File "${file?.name}" exceeds 20MB limit.`,
        'wrongType': `File "${file?.name}" is not a supported file type.`,
        'tooMany': `Too many files. Only first 5 files were uploaded.`
      }

      listItem.textContent = errorMsgs[errorType] || `Error with ${file.name}`
      errorsList.appendChild(listItem)
    }

    // Update FileList
    function updateFileList() {
      // Use DataTransfer object to modify FileList
      const dt = new DataTransfer();
      currentFilesArr.forEach(file => {
        dt.items.add(file)
      });

      // Update fileInput element directly
      fileInput.files = dt.files; 

      clearBtn.disabled = false
    }


    // Preview files to be uploaded
    function previewFiles() {
      while (preview.firstChild) {
        preview.removeChild(preview.firstChild);
      }

      const list = document.createElement("ol");
      list.classList.add('.upload__preview-list')
      preview.appendChild(list);

      const currentFiles = fileInput.files

      for(const file of currentFiles) {
        const listItem = document.createElement("li");
        listItem.classList.add('upload__item')
        const para = document.createElement("p");
        para.innerHTML = `<strong>File name:</strong> ${file.name}, 
          <strong>File size:</strong> ${returnFileSize(file.size,)} (${file.size} bytes).`;

        const fileType = file.type
        const fileURL = URL.createObjectURL(file)

        // Image file
        if(fileType.startsWith('image/')) {
          const image = document.createElement("img");
          image.src = fileURL;
          image.alt = image.title = file.name;
          image.style.width = "120px"
          image.style.height = "80px"

          listItem.appendChild(image);
          listItem.appendChild(para);
        } else if (fileType.startsWith('audio/')) { // Audio file
          
          const image = document.createElement("img");
          image.src = `/icons/music-icon.svg`;
          image.alt = image.title = file.name;
          image.style.width = "120px"
          image.style.height = "80px"

          listItem.appendChild(image);
          listItem.appendChild(para);
        } else if (fileType.startsWith('video/')) { // Video file
          const video = document.createElement("video")
          video.src = fileURL
          video.style.width = "120px"
          video.style.height = "80px"
          video.style.objectFit = 'cover'
          video.currentTime = 1; // Load the first frame as a "preview"

          listItem.appendChild(video);
          listItem.appendChild(para);
        } else if (fileType === 'application/msword' || fileType === 
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document') {
          // Show doc icon
          

          const image = document.createElement("img");
          image.src = `/icons/ms-word-icon.svg`;
          image.alt = image.title = file.name;
          image.style.width = "120px"
          image.style.height = "80px"

          listItem.appendChild(image);
          listItem.appendChild(para);

        } else if (fileType === 'application/pdf') {
         
          const pdf = document.createElement('iframe')
          pdf.src = fileURL
          pdf.width = '120px'
          pdf.height = '80px'

          listItem.appendChild(pdf)
          
          listItem.appendChild(para);
        }
        list.appendChild(listItem);
        const hr = document.createElement('hr')
        list.appendChild(hr)
      }
    }

    // Calculate file size
    function returnFileSize(number) {
      if (number < 1024) {
        return `${number} bytes`;
      } else if (number >= 1024 && number < 1024 * 1024) {
        return `${(number / 1024).toFixed(2)} KB`;
      }
      return `${(number / (1024 * 1024)).toFixed(2)} MB`;
    }

    fileInput.addEventListener("change", 
      
      () => {
        errorsList.innerHTML = ''
        validateFileTypeAndSize()
        validateFileListLength()
        updateFileList()
        previewFiles()
      }
    );

    clearBtn.addEventListener('click', () => {
      currentFilesArr = []
      updateFileList()
      previewFiles()
      submitBtn.disabled = true
      clearBtn.disabled = true

      // Add para text back
      const para = document.createElement('p')
      para.classList.add('upload__text')
      para.textContent = `No files currently selected for upload`
      preview.appendChild(para)
    })

    // Add underline for active link
     window.addEventListener('DOMContentLoaded', () => {
      const currentPath = window.location.pathname
      const navLinks = document.querySelectorAll('.nav__link')

      navLinks.forEach(link => {
        const linkPath = link.getAttribute('href')
        if(linkPath === currentPath) {
          link.classList.add('active')
        }
      })
    })
  </script>
</html>
