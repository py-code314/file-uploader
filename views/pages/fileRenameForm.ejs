<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <div class="main-layout">
      <% if (locals.currentUser) { %>
        <!-- Sidebar  -->
      <%- include('../partials/sidebar.ejs') %>
      <% } %>

      <!-- Main content-->
      <main class="main">
        <div >

          <!-- Show errors -->
          <% if(locals.errors && locals.errors.length > 0) { %>
            <%- include('../partials/errors.ejs') %>
          <% }  %>

        
          <div class="file-rename">
            <form class="form form--file-rename" action="<%= locals.folderId ? `/folders/${folderId}/files/${fileId}/update` : `/files/${fileId}/update` %>" method="POST">
              <h2 >Rename File</h2>
              <div class="form__control">
                <label class="form__label" for="fileName">File Name (required)
                </label>
                <input
                  class="form__input"
                  id="fileName"
                  name="name"
                  placeholder="Name"
                  type="text"
                  value="<%= locals.isRename || locals.errors ? `${fileName}` : '' %>"
                  autofocus
                    />
              </div>
              <div class="form__btns">
                <a href="<%= locals.folderId ? `/folders/${folderId}` : `/` %>" class="btn  btn--cancel">Cancel</a>
                <button class="btn  btn--submit" type="submit">
                  Update
                </button>
              </div>
            </form>
          </div>
        </div>
        
      </main>
    </div>
    

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>
  </body>
  
 
</html>
