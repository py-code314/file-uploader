<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <div class="main-layout">
      <% if (locals.currentUser) { %>
        <!-- Sidebar  -->
      <%- include('../partials/sidebar.ejs') %>
      <% } %>

      <!-- Main content-->
      <main class="main">
        <!-- Show errors -->
          <% if(locals.errors && locals.errors.length > 0) { %>
            <%- include('../partials/errors.ejs') %>
          <% }  %>

        <!-- New folder form -->
        <div class="new-folder">
          <form class="form form--new-folder" action="<%= locals.isRename ? `/folders/${folder.id}/update` : locals.folderId ? `/folders/${folderId}/new` : `/folders/new` %>" method="POST">
            <h2 ><%= locals.isRename ? 'Update Folder' : 'New Folder' %></h2>
            <!-- Folder name -->
            <div class="form__control">
              <label class="form__label new-folder__label" for="folderName">Folder Name (required)
              </label>
              <span class="new-folder__instructions"><strong>Allowed characters:</strong> Letters, numbers, spaces, underscore and hyphen</span>
              <input
                class="form__input"
                id="folderName"
                name="name"
                placeholder="Name"
                type="text"
                value="<%= locals.isRename || locals.errors ? `${locals.folder?.name}` : '' %>"
                pattern="[a-zA-Z0-9\s_\-]+"
                autofocus
                required
                  />
            </div>
            <!-- Form buttons -->
            <div class="form__btns">
              <!-- Cancel link -->
              <a href="<%= locals.parentId ? `/folders/${parentId}` : locals.folderId ? `/folders/${folderId}` : `/` %>" class="btn  btn--cancel">Cancel</a>
              <!-- Rename button -->
              <button class="btn  btn--submit" type="submit">
                <%= locals.isRename ? 'Update' : 'Create' %>
              </button>
            </div>
          </form>
        </div>
      </main>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>
  </body>

  <script>
    /* Add underline for active link */
     window.addEventListener('DOMContentLoaded', () => {
      const currentPath = window.location.pathname
      const navLinks = document.querySelectorAll('.nav__link')

      navLinks.forEach(link => {
        const linkPath = link.getAttribute('href')
        if(linkPath === currentPath) {
          link.classList.add('active')
        }
      })
    })
  </script>
</html>
