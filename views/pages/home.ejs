<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>

      <!-- Header -->
      <%- include('../partials/header.ejs') %>
      <div class="main-layout">
        <% if (locals.currentUser) { %>
          <!-- Sidebar  -->
        <%- include('../partials/sidebar.ejs') %>
        <% } %>
      
        <!-- Main content-->
        <main class="main">

          <section class="hero">
            <h2 class="hero__heading">Upload Files Easy</h2>
            <div class="hero__upload"><img class="hero__img" src="/images/upload.svg" alt="" width="350" height="200"></div>
            <div class="hero__cloud"><img class="hero__img" src="/images/cloud-compute.jpg" alt="" width="700" height="300"></div>
          </section>

          <section class="features">
            <div>
              <h3>Easy Upload</h3>
              <img src="/icons/file-icon.svg" alt="">
              <p>Upload your files seamlessly. Our system processes and prepares your data instantly without any complicated setup.</p>
            </div>
            <div>
              <h3>Zero-Knowledge Privacy</h3>
              <img src="/icons/lock-icon.svg" alt="">
              <p>Security isn't an afterthought. Your files are encrypted instantly upon upload and safely locked away in our cloud vaults, ensuring your data remains permanently protected and accessible only to you.</p>
            </div>
            <div>
              <h3>Light Speed Delivery</h3>
              <img src="icons/lightning-icon.svg" alt="">
              <p>
                Powered by dynamic cloud transformations, you can access your files anytime, on any device without draining your local bandwidth or memory.</p>
            </div>
          </section>

          <% if (locals.currentUser) { %>
            <!-- Show folders -->
            <% if(locals.folders && locals.folders.length > 0) { %>
              <%- include('../partials/folders.ejs') %>
            <% }  %>

            <!-- Show files -->
            <% if(locals.files && locals.files.length > 0) { %>
              <%- include('../partials/files.ejs') %>
            <% }  %>
          <% } %>
          
      
        </main>
      </div>
      <!-- Footer -->
      <%- include('../partials/footer.ejs') %>

  </body>
  <script>
    const fileLinks = document.querySelectorAll('.file__link')
    


    fileLinks.forEach(fileLink => {
      const fileLinkValue = fileLink.getAttribute('data-name')
      const fileLinkArr = fileLinkValue.split('.')

      // Remove file extension
      const baseName = fileLinkArr[0]
      fileLink.textContent = `${baseName}`
    })

    window.addEventListener('DOMContentLoaded', () => {
      const currentPath = window.location.pathname
      const navLinks = document.querySelectorAll('.nav__link')

      navLinks.forEach(link => {
        const linkPath = link.getAttribute('href')
        if(linkPath === currentPath) {
          link.classList.add('active')
        }
      })
    })
    
  </script>
</html>
