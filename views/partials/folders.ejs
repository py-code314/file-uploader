<section class="folders">
  <h2 class="folders__heading">Folders</h2>
  <% if (locals.folders) {%>
    <!-- Folders list -->
    <ul class="folders__list">
      <% folders.forEach((folder) => { %>
        <li class="folder" >
          <a class="folder__name" href="/folders/<%= folder.id %>">
            <img src="/icons/folder-icon.svg" alt="" width="30" height="30" />
            <%= folder.name %>
          </a>
          <div class="folder__btns">
            <!-- Update folder name -->
            <a class="link link--update folder__update" aria-label="Rename" href="/folders/<%= folder.id %>/update">
              <img src="/icons/edit-icon.svg" alt="" width="25" height="25" title="Rename" focusable="false" />
            </a>

            <!-- Delete folder -->
            <form id="folder-form" action="/folders/<%= folder.id %>/delete" method="POST" >
              <button class="btn--delete" type="submit"  aria-label="Delete" onclick="return confirm('This will delete ALL data inside this folder. Are you sure you want to continue?')">
                <img src="/icons/delete-icon.svg" alt="" width="25" height="25" title="Delete" focusable="false" />
              </button>
            </form>
          </div>
        </li>
        <hr>

        
        
      <% }); %>
    </ul>
  <% } %>
</section>


