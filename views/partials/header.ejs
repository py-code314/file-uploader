<header class="header">
  <div class="brand">
    <!-- Logo -->
    <div class="logo">
      <img src="/icons/diamond-icon.svg" alt="Logo" width="40" height="40">
    </div>

    <div class="title-container">
      <!-- Title -->
      <a href="/">
        <h1 class="title">Nexus</h1>
      </a>
    </div>
  </div>

  <!-- Primary navigation -->
  <nav class="nav" aria-label="Primary">
      <ul class="nav__main">
        <li class="nav__item"><a href="/" class="nav__link">Home</a></li>
        <li class="nav__item">About Us</li>
        <li class="nav__item">Features</li>
        <li class="nav__item">Pricing</li>
      </ul>
        
      <ul class="nav__user">
        <% if(locals.currentUser) { %>
          <li class="nav__item nav__profile"><img src="/icons/profile-icon.svg" alt="" width="30" height="30" title="Profile" aria-hidden="true" focusable="false">Profile</li>
          <li>
            <form action="/logOut" method="post">
              <button class=" btn btn--logout nav__link" type="submit"><img  src="/icons/log-out-icon.svg" alt="" width="27" height="27" title="Log Out" aria-hidden="true" focusable="false">Log Out</button>
            </form>
          </li>
        <% } else { %>
          <li class="nav__item"><a class="nav__link link link--logIn" href="/logIn">Log In</a></li>
          <li class="nav__item"><a class="nav__link link link--signUp" href="/signUp">Sign Up</a></li>
        <% } %>
      </ul>
  </nav>
</header>
